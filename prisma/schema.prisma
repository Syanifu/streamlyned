generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String                   @id @default(uuid())
  email              String                   @unique
  name               String
  avatarUrl          String?
  coverUrl           String?
  planTier           String                   @default("standard")
  storageUsedBytes   BigInt                   @default(0)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  passwordHash       String?
  auditLogs          AuditLog[]
  calendarAttendees  CalendarEventAttendee[]
  chatMessages       ChatMessage[]
  chatReactions      ChatMessageReaction[]
  checkInAnswers     CheckInAnswer[]
  comments           Comment[]
  discussions        Discussion[]
  discussionSubs     DiscussionSubscription[]
  dmMemberships      DmGroupMember[]
  notifications      Notification[]
  projectMemberships ProjectMember[]
  projectFiles       ProjectFile[]
  knowledgeUploads   WorkspaceKnowledge[]
  taskAssignees      TaskAssignee[]
  memberships        WorkspaceMember[]
  aiConfigs          AiConfig[]
  googleCalendarToken GoogleCalendarToken?
  sessions           Session[]
  connections        Connection[]
  approvalSignoffs   ApprovalSignoff[]
  inspectionRequests ItpInspectionRequest[]
}

model Workspace {
  id               String               @id @default(uuid())
  name             String
  slug             String               @unique
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  apiKey           String?              @unique
  aiSettings       AiSettings?
  auditLogs        AuditLog[]
  events           CalendarEvent[]
  chatMessages     ChatMessage[]
  checkInQuestions CheckInQuestion[]
  comments         Comment[]
  discussions      Discussion[]
  dmGroups         DmGroup[]
  docs             Doc[]
  embeddings       Embedding[]
  notifications    Notification[]
  projects         Project[]
  members          WorkspaceMember[]
  knowledgeFiles   WorkspaceKnowledge[]
  aiConfig         AiConfig?
  notionConnection NotionConnection?
  sessions         Session[]
  connections      Connection[]
  outboxEvents       OutboxEvent[]
  chartOfAccounts    ChartOfAccounts[]
  generalLedgerEntries GeneralLedgerEntry[]
  itemMasters        ItemMaster[]
  supplierMasters    SupplierMaster[]
  customerMasters    CustomerMaster[]
  approvalRequests   ApprovalRequest[]
  materialRequests   MaterialRequest[]
  purchaseOrders     PurchaseOrder[]
  inventoryMovements InventoryMovement[]
  dailyProgressReports DailyProgressReport[]
  clientContracts    ClientContract[]
  raBills            RaBill[]
  purchaseInvoices   PurchaseInvoice[]
  periodLocks        PeriodLock?
  drawingDocuments   DrawingDocument[]
  drawingTransmittals DrawingTransmittal[]
  itpInspectionRequests ItpInspectionRequest[]
  nonConformanceReports NonConformanceReport[]
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  role        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Project {
  id               String            @id @default(uuid())
  workspaceId      String
  name             String
  description      String?
  isArchived       Boolean           @default(false)
  archivedAt       DateTime?
  deletedAt        DateTime?
  tools            String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  startDate      DateTime?
  endDate        DateTime?
  agenticEnabled Boolean           @default(true) @map("agentic_enabled")
  auditLogs      AuditLog[]
  events           CalendarEvent[]
  chatMessages     ChatMessage[]
  checkInQuestions CheckInQuestion[]
  discussions      Discussion[]
  docs             Doc[]
  files            ProjectFile[]
  hillChartItems   HillChartItem[]
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members          ProjectMember[]
  taskLists        TaskList[]
  generalLedgerEntries GeneralLedgerEntry[]
  wbsNodes           WbsNode[]
  materialRequests   MaterialRequest[]
  purchaseOrders     PurchaseOrder[]
  dailyProgressReports DailyProgressReport[]
  clientContracts    ClientContract[]
  raBills            RaBill[]
  drawingDocuments   DrawingDocument[]
  drawingTransmittals DrawingTransmittal[]
}

model ProjectMember {
  id           String   @id @default(uuid())
  projectId    String
  userId       String
  visibleTools String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model TaskList {
  id        String  @id @default(uuid())
  projectId String
  name      String
  position  Float
  tasks     Task[]
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Task {
  id               String           @id @default(uuid())
  workspaceId      String
  taskListId       String
  projectId        String
  title            String
  notes            String?
  dueDateStart     DateTime?
  dueDateEnd       DateTime?
  recurrence       String?
  position         Float
  isCompleted      Boolean          @default(false)
  completedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  visibleToClients Boolean          @default(true)
  priority         String           @default("P4")
  comments         Comment[]
  taskList         TaskList         @relation(fields: [taskListId], references: [id], onDelete: Cascade)
  assignees        TaskAssignee[]
  attachments      TaskAttachment[]
}

model TaskAssignee {
  id     String @id @default(uuid())
  taskId String
  userId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

model TaskAttachment {
  id        String   @id @default(uuid())
  taskId    String
  fileName  String
  fileUrl   String
  fileSize  Int
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model ProjectFile {
  id           String   @id @default(uuid())
  workspaceId  String
  projectId    String
  fileName     String
  fileUrl      String
  fileSize     Int
  mimeType     String
  uploadedById String
  createdAt    DateTime @default(now())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
}

model Comment {
  id              String      @id @default(uuid())
  workspaceId     String
  taskId          String?
  discussionId    String?
  docId           String?
  userId          String
  content         String
  isClientComment Boolean     @default(false)
  createdAt       DateTime    @default(now())
  discussion      Discussion? @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  doc             Doc?        @relation(fields: [docId], references: [id], onDelete: Cascade)
  task            Task?       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace       Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Discussion {
  id               String                   @id @default(uuid())
  workspaceId      String
  projectId        String
  title            String
  content          String
  userId           String
  isPinned         Boolean                  @default(false)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  visibleToClients Boolean                  @default(true)
  comments         Comment[]
  project          Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace        Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subs             DiscussionSubscription[]
}

model DiscussionSubscription {
  id           String     @id @default(uuid())
  discussionId String
  userId       String
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([discussionId, userId])
}

model ChatMessage {
  id          String                @id @default(uuid())
  workspaceId String
  projectId   String?
  dmGroupId   String?
  userId      String
  content     String
  createdAt   DateTime              @default(now())
  dmGroup     DmGroup?              @relation(fields: [dmGroupId], references: [id], onDelete: Cascade)
  project     Project?              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  files       ChatMessageFile[]
  reactions   ChatMessageReaction[]
}

model ChatMessageReaction {
  id        String      @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

model ChatMessageFile {
  id        String      @id @default(uuid())
  messageId String
  fileName  String
  fileUrl   String
  fileSize  Int
  createdAt DateTime    @default(now())
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model DmGroup {
  id          String          @id @default(uuid())
  workspaceId String
  name        String?
  createdAt   DateTime        @default(now())
  messages    ChatMessage[]
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     DmGroupMember[]
}

model DmGroupMember {
  id        String  @id @default(uuid())
  dmGroupId String
  userId    String
  dmGroup   DmGroup @relation(fields: [dmGroupId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dmGroupId, userId])
}

model Doc {
  id               String       @id @default(uuid())
  workspaceId      String
  projectId        String
  title            String
  content          String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  visibleToClients Boolean      @default(true)
  comments         Comment[]
  project          Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace        Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions         DocVersion[]
}

model DocVersion {
  id          String   @id @default(uuid())
  docId       String
  title       String
  content     String
  version     Int
  createdAt   DateTime @default(now())
  createdById String
  doc         Doc      @relation(fields: [docId], references: [id], onDelete: Cascade)
}

model CalendarEvent {
  id               String                  @id @default(uuid())
  workspaceId      String
  projectId        String
  title            String
  description      String?
  startAt          DateTime
  endAt            DateTime
  recurrence       String?
  videoCallLink    String?
  location         String?
  createdAt        DateTime                @default(now())
  priority         String                  @default("P4")
  source           String                  @default("manual")
  sourceRef        String?                 @map("source_ref") @db.Uuid
  progressPct      Int?                    @map("progress_pct")
  agentConfidence  String?                 @map("agent_confidence")
  project          Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace        Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  attendees        CalendarEventAttendee[]
}

model CalendarEventAttendee {
  id      String        @id @default(uuid())
  eventId String
  userId  String
  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model Notification {
  id           String    @id @default(uuid())
  workspaceId  String
  userId       String
  type         String
  title        String
  message      String
  targetUrl    String
  isRead       Boolean   @default(false)
  isSuppressed Boolean   @default(false)
  createdAt    DateTime  @default(now())
  priority     String    @default("P4")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String    @id @default(uuid())
  workspaceId String
  projectId   String?
  entityType  String
  entityId    String
  userId      String
  action      String
  description String
  createdAt   DateTime  @default(now())
  priority    String    @default("P4")
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Embedding {
  id          String    @id @default(uuid())
  workspaceId String
  entityType  String
  entityId    String
  projectId   String?
  text        String
  vector      String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model AiSettings {
  id              String    @id @default(uuid())
  workspaceId     String    @unique
  provider        String    @default("openai")
  apiKey          String?
  embeddingsModel String    @default("text-embedding-3-small")
  completionModel String    @default("gpt-4o-mini")
  config          String    @default("{}")
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model CheckInQuestion {
  id           String          @id @default(uuid())
  workspaceId  String
  projectId    String
  question     String
  scheduleDay  String
  scheduleTime String
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  answers      CheckInAnswer[]
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model CheckInAnswer {
  id         String          @id @default(uuid())
  questionId String
  userId     String
  content    String
  createdAt  DateTime        @default(now())
  question   CheckInQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HillChartItem {
  id        String   @id @default(uuid())
  projectId String
  name      String
  progress  Float    @default(50.0)
  color     String   @default("#6366f1")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model AiConfig {
  id           String    @id @default(uuid())
  orgId        String    @unique @map("org_id")
  systemPrompt String    @map("system_prompt")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy    String    @map("updated_by")
  workspace    Workspace @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [updatedBy], references: [id], onDelete: Cascade)

  @@map("ai_config")
}

model GoogleCalendarToken {
  id            String    @id @default(uuid())
  userId        String    @unique
  accessToken   String
  refreshToken  String?
  expiresAt     DateTime?
  syncedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WorkspaceKnowledge {
  id           String    @id @default(uuid())
  workspaceId  String
  name         String
  description  String?
  fileUrl      String
  fileSize     Int
  mimeType     String
  textContent  String?
  uploadedById String
  createdAt    DateTime  @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])
}

model NotionConnection {
  id            String    @id @default(uuid())
  workspaceId   String    @unique
  accessToken   String
  botId         String
  notionWorkspaceName String?
  notionWorkspaceIcon String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// --- Phase 0: Secure session model ---
model Session {
  id            String    @id @default(uuid())
  userId        String
  workspaceId   String
  tokenHash     String    @unique
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime  @default(now())
  ipHash        String?
  userAgentHash String?
  revokedAt     DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// --- Phase 1: Unified integration connection model ---
model Connection {
  id                  String         @id @default(uuid())
  provider            String
  ownerType           String         // USER | WORKSPACE
  userId              String?
  workspaceId         String?
  externalAccountId   String?
  externalAccountName String?
  accessToken         String         // encrypted (AES-256-GCM)
  refreshToken        String?        // encrypted
  tokenType           String?
  tokenSecret         String?        // encrypted, oauth1
  scopes              String         @default("[]") // JSON array
  expiresAt           DateTime?
  status              String         @default("active") // active|expired|revoked|error
  lastSyncedAt        DateTime?
  lastError           String?
  metadata            String?        // JSON
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  user                User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace           Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  externalItems       ExternalItem[]
}

// --- Phase 1: Dedup tracking for imported external content ---
model ExternalItem {
  id              String     @id @default(uuid())
  connectionId    String
  provider        String
  externalId      String
  externalType    String     // page|database|record|file|doc|note
  localEntityType String     // DOC|PROJECT|TASK|FILE|EMBEDDING
  localEntityId   String
  contentHash     String?
  syncDirection   String     @default("inbound")
  lastSyncedAt    DateTime   @default(now())
  connection      Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalId])
}

// --- Cross-cutting: Append-only audit trail ---
model AuditEvent {
  id           String   @id @default(uuid())
  actorUserId  String?
  workspaceId  String?
  action       String
  resourceType String?
  resourceId   String?
  ipHash       String?
  metadata     String?  // JSON
  createdAt    DateTime @default(now())
}

// --- Transactional Outbox Pattern ---
model OutboxEvent {
  id          String    @id @default(uuid())
  workspaceId String
  eventType   String    // e.g. "E03", "purchase_order.submitted"
  payload     String    // JSON payload
  status      String    @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED
  error       String?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

// --- Chart of Accounts (COA) ---
model ChartOfAccounts {
  id          String               @id @default(uuid())
  workspaceId String
  code        String               // e.g. "1000", "2000"
  name        String
  type        String               // ASSET | LIABILITY | EQUITY | REVENUE | EXPENSE
  parentCode  String?
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ledgerEntries GeneralLedgerEntry[]

  @@unique([workspaceId, code])
}

// --- General Ledger Entry ---
model GeneralLedgerEntry {
  id            String          @id @default(uuid())
  workspaceId   String
  projectId     String?
  wbsCode       String?
  coaCode       String
  debit         Float           @default(0.0)
  credit        Float           @default(0.0)
  ledgerDate    DateTime
  referenceType String          // e.g. "GRN", "INVOICE", "PAYROLL"
  referenceId   String
  description   String?
  createdAt     DateTime        @default(now())
  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project       Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  coa           ChartOfAccounts @relation(fields: [workspaceId, coaCode], references: [workspaceId, code])

  @@index([workspaceId, ledgerDate])
  @@index([workspaceId, coaCode])
}

// --- Item Master ---
model ItemMaster {
  id          String    @id @default(uuid())
  workspaceId String
  code        String
  name        String
  description String?
  uom         String    // KG | M | PCS etc.
  group       String    // RAW_MATERIAL | CONSUMABLE | SERVICES
  isActive    Boolean   @default(true)
  costingRule String    @default("MOVING_AVERAGE")
  hsnCode     String?
  reorderLevel Float?
  reorderQty   Float?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, code])
}

// --- Supplier Master ---
model SupplierMaster {
  id           String    @id @default(uuid())
  workspaceId  String
  code         String
  name         String
  gstin        String?
  email        String?
  phone        String?
  bankName     String?
  bankAccount  String?
  bankIfsc     String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, code])
}

// --- Customer Master ---
model CustomerMaster {
  id           String    @id @default(uuid())
  workspaceId  String
  code         String
  name         String
  gstin        String?
  creditLimit  Float?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, code])
}

// --- Approval Request & Signoffs ---
model ApprovalRequest {
  id           String             @id @default(uuid())
  workspaceId  String
  documentType String             // MR | PO | DPR
  documentId   String
  amount       Float              @default(0.0)
  status       String             @default("PENDING") // PENDING | APPROVED | REJECTED
  currentStep  Int                @default(1)
  maxStep      Int                @default(1)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  signoffs     ApprovalSignoff[]

  @@unique([workspaceId, documentType, documentId])
}

model ApprovalSignoff {
  id             String          @id @default(uuid())
  requestId      String
  step           Int
  approverUserId String
  status         String          @default("PENDING") // PENDING | APPROVED | REJECTED
  actionComment  String?
  actedAt        DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  request        ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approver       User            @relation(fields: [approverUserId], references: [id], onDelete: Cascade)

  @@unique([requestId, step, approverUserId])
}

// --- WBS Node & Budget Spine ---
model WbsNode {
  id               String               @id @default(uuid())
  projectId        String
  code             String               // e.g. "1.1.1", "1.2"
  name             String
  budgetLimit      Float                @default(0.0)
  actualCost       Float                @default(0.0)
  committedCost    Float                @default(0.0)
  parentCode       String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  project          Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  poItems          PurchaseOrderItem[]
  materialReqs     MaterialRequest[]
  inventoryMovements InventoryMovement[]
  dprQtyLines      DprQuantityLine[]
  raBillItems      RaBillItem[]
  workPackages     WbsWorkPackage[]
  inspectionRequests ItpInspectionRequest[]
  ncrReports       NonConformanceReport[]

  @@unique([projectId, code])
}

// --- Material Request ---
model MaterialRequest {
  id            String                @id @default(uuid())
  workspaceId   String
  projectId     String
  wbsNodeId     String?
  requestNumber String                // unique per workspace
  status        String                @default("PENDING") // PENDING | APPROVED | REJECTED | ORDERED
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  workspace     Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project       Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsNode       WbsNode?              @relation(fields: [wbsNodeId], references: [id])
  items         MaterialRequestItem[]

  @@unique([workspaceId, requestNumber])
}

model MaterialRequestItem {
  id           String          @id @default(uuid())
  requestId    String
  itemCode     String
  quantity     Float
  requiredDate DateTime?
  request      MaterialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

// --- Purchase Order ---
model PurchaseOrder {
  id            String              @id @default(uuid())
  workspaceId   String
  projectId     String
  poNumber      String              // unique per workspace
  supplierCode  String
  status        String              @default("PENDING") // PENDING | APPROVED | REJECTED | CLOSED
  totalAmount   Float               @default(0.0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  workspace     Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items         PurchaseOrderItem[]

  @@unique([workspaceId, poNumber])
}

model PurchaseOrderItem {
  id         String        @id @default(uuid())
  poId       String
  itemCode   String
  quantity   Float
  rate       Float
  wbsNodeId  String?
  po         PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  wbsNode    WbsNode?      @relation(fields: [wbsNodeId], references: [id])
}

// --- Inventory Movement (Ledger) ---
model InventoryMovement {
  id            String    @id @default(uuid())
  workspaceId   String
  type          String    // GRN | ISSUE | TRANSFER
  itemCode      String
  quantity      Float     // positive for receipt, negative for issue
  rate          Float     // valuation rate at movement
  referenceType String    // PO | DPR
  referenceId   String
  projectId     String?
  wbsNodeId     String?
  warehouse     String    @default("MAIN")
  createdAt     DateTime  @default(now())
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  wbsNode       WbsNode?  @relation(fields: [wbsNodeId], references: [id])

  @@index([workspaceId, itemCode, warehouse])
}

// --- Daily Progress Report ---
model DailyProgressReport {
  id               String               @id @default(uuid())
  workspaceId      String
  projectId        String
  reportDate       DateTime
  status           String               @default("DRAFT") // DRAFT | SUBMITTED | VERIFIED
  reportedByUserId String
  createdAt        DateTime             @default(now())
  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project          Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  qtyLines         DprQuantityLine[]
  labourLines      DprLabourLine[]
  equipmentLines   DprEquipmentLine[]

  @@unique([projectId, reportDate])
}

model DprQuantityLine {
  id        String              @id @default(uuid())
  dprId     String
  wbsNodeId String
  quantity  Float
  dpr       DailyProgressReport @relation(fields: [dprId], references: [id], onDelete: Cascade)
  wbsNode   WbsNode             @relation(fields: [wbsNodeId], references: [id], onDelete: Cascade)
}

model DprLabourLine {
  id          String              @id @default(uuid())
  dprId       String
  trade       String              // MASON | WELDER | HELPER
  headcount   Int
  hours       Float
  ratePerHour Float
  dpr         DailyProgressReport @relation(fields: [dprId], references: [id], onDelete: Cascade)
}

model DprEquipmentLine {
  id           String              @id @default(uuid())
  dprId        String
  equipmentCode String
  runningHours Float
  idleHours    Float
  ratePerHour  Float
  dpr          DailyProgressReport @relation(fields: [dprId], references: [id], onDelete: Cascade)
}

// --- Client Contract ---
model ClientContract {
  id                 String          @id @default(uuid())
  workspaceId        String
  projectId          String
  contractNumber     String          // unique per workspace
  customerCode       String
  totalValue         Float           @default(0.0)
  advanceAmount      Float           @default(0.0) // Mobilization advance paid
  advanceRecoveryPct Float           @default(0.0) // percentage to recover per bill
  retentionPct       Float           @default(0.0) // retention percentage
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  workspace          Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project            Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  raBills            RaBill[]

  @@unique([workspaceId, contractNumber])
}

// --- Running Account Client Bill ---
model RaBill {
  id                   String       @id @default(uuid())
  workspaceId          String
  projectId            String
  contractId           String
  billNumber           String       // unique per workspace/project e.g. "RA-01"
  cumulativeClaimed    Float        @default(0.0)
  cumulativeCertified  Float        @default(0.0)
  retentionDeduction   Float        @default(0.0)
  advanceRecovery      Float        @default(0.0)
  netPayable           Float        @default(0.0)
  status               String       @default("DRAFT") // DRAFT | SUBMITTED | CERTIFIED | PAID
  billingDate          DateTime
  certifiedAt          DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  workspace            Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project              Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contract             ClientContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  items                RaBillItem[]

  @@unique([projectId, billNumber])
}

model RaBillItem {
  id              String   @id @default(uuid())
  billId          String
  wbsNodeId       String
  claimedQty      Float
  certifiedQty    Float
  rate            Float
  bill            RaBill   @relation(fields: [billId], references: [id], onDelete: Cascade)
  wbsNode         WbsNode  @relation(fields: [wbsNodeId], references: [id], onDelete: Cascade)
}

// --- Purchase Invoice (for 3-Way Match) ---
model PurchaseInvoice {
  id             String                @id @default(uuid())
  workspaceId    String
  projectId      String
  invoiceNumber  String
  supplierCode   String
  status         String                @default("PENDING") // PENDING | MATCHED | MISMATCHED | APPROVED
  totalAmount    Float                 @default(0.0)
  invoiceDate    DateTime
  poId           String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  workspace      Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items          PurchaseInvoiceItem[]

  @@unique([workspaceId, supplierCode, invoiceNumber])
}

model PurchaseInvoiceItem {
  id           String          @id @default(uuid())
  invoiceId    String
  itemCode     String
  quantity     Float
  rate         Float
  invoice      PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

// --- Period Lock Settings ---
model PeriodLock {
  id             String    @id @default(uuid())
  workspaceId    String    @unique
  lockDate       DateTime
  lockedByUserId String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// --- Engineering Drawing Document ---
model DrawingDocument {
  id             String            @id @default(uuid())
  workspaceId    String
  projectId      String
  drawingNumber  String            // e.g. "METRO-STR-101"
  title          String
  discipline     String            // STRUCTURAL | ELECTRICAL | MECHANICAL | CIVIL
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisions      DrawingRevision[]

  @@unique([projectId, drawingNumber])
}

// --- Drawing Revision ---
model DrawingRevision {
  id             String             @id @default(uuid())
  drawingId      String
  revisionNumber String             // e.g. "R0", "R1"
  status         String             @default("DRAFT") // DRAFT | APPROVED | IFC
  fileUrl        String
  fileSize       Int
  releasedAt     DateTime?
  isSuperseded   Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  drawing        DrawingDocument    @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  transmittals   TransmittalItem[]
  workPackages   WbsWorkPackage[]
  inspections    ItpInspectionRequest[]

  @@unique([drawingId, revisionNumber])
}

// --- Drawing Transmittal ---
model DrawingTransmittal {
  id                String            @id @default(uuid())
  workspaceId       String
  projectId         String
  transmittalNumber String            // unique per workspace
  recipientEmail    String
  sentAt            DateTime          @default(now())
  receivedAt        DateTime?
  createdAt         DateTime          @default(now())
  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items             TransmittalItem[]

  @@unique([workspaceId, transmittalNumber])
}

model TransmittalItem {
  id            String             @id @default(uuid())
  transmittalId String
  revisionId    String
  transmittal   DrawingTransmittal @relation(fields: [transmittalId], references: [id], onDelete: Cascade)
  revision      DrawingRevision    @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@unique([transmittalId, revisionId])
}

// --- WBS Node Work Package mapping ---
model WbsWorkPackage {
  id                String          @id @default(uuid())
  wbsNodeId         String
  drawingRevisionId String
  status            String          @default("ACTIVE") // ACTIVE | HOLD | COMPLETED
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  wbsNode           WbsNode         @relation(fields: [wbsNodeId], references: [id], onDelete: Cascade)
  drawingRevision   DrawingRevision @relation(fields: [drawingRevisionId], references: [id], onDelete: Cascade)

  @@unique([wbsNodeId, drawingRevisionId])
}

// --- Quality: ITP Inspection Request ---
model ItpInspectionRequest {
  id                String                @id @default(uuid())
  workspaceId       String
  wbsNodeId         String
  drawingRevisionId String?
  inspectorUserId   String
  status            String                @default("PENDING") // PENDING | PASSED | FAILED
  resultComment     String?
  inspectedAt       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  wbsNode           WbsNode               @relation(fields: [wbsNodeId], references: [id], onDelete: Cascade)
  drawingRevision   DrawingRevision?      @relation(fields: [drawingRevisionId], references: [id])
  inspector         User                  @relation(fields: [inspectorUserId], references: [id], onDelete: Cascade)
  ncr               NonConformanceReport?
}

// --- Quality: Non-Conformance Report (NCR) ---
model NonConformanceReport {
  id                  String               @id @default(uuid())
  workspaceId         String
  inspectionRequestId String               @unique
  ncrNumber           String               // unique per workspace
  wbsNodeId           String
  description         String
  severity            String               @default("MINOR") // MINOR | MAJOR
  status              String               @default("OPEN") // OPEN | RESOLVED | CLOSED
  disposition         String?              // REWORK | USE_AS_IS | REJECT
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inspectionRequest   ItpInspectionRequest @relation(fields: [inspectionRequestId], references: [id], onDelete: Cascade)
  wbsNode             WbsNode              @relation(fields: [wbsNodeId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, ncrNumber])
}
